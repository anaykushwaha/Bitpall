{
  "name": "@aegisscript/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@aegisscript/ast": "workspace:*",
    "@aegisscript/checker": "workspace:*",
    "@aegisscript/interpreter": "workspace:*",
    "@aegisscript/language-service": "workspace:*",
    "@aegisscript/parser": "workspace:*",
    "@aegisscript/runtime": "workspace:*",
    "@aegisscript/test-runner": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
